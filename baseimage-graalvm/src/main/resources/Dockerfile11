FROM ${docker.from.id}:${docker.from.version}

ARG GRAALVM_VERSION=22.3.3

# Download and setup GraalVM Community (trimming it down somewhat since it is huuge)
# GraalVM stopped updating Java 11 build after 22.3.3
RUN wget -O /tmp/graalvm-ce-java11-${GRAALVM_VERSION}.tar.gz https://github.com/graalvm/graalvm-ce-builds/releases/download/vm-${GRAALVM_VERSION}/graalvm-ce-java11-linux-amd64-${GRAALVM_VERSION}.tar.gz \
   && bsdtar xzf /tmp/graalvm-ce-java11-${GRAALVM_VERSION}.tar.gz \
   && mkdir -p /usr/lib/jvm \
   && mv /graalvm-ce-java11-${GRAALVM_VERSION} /usr/lib/jvm/ \
   && rm /tmp/graalvm-ce-java11-${GRAALVM_VERSION}.tar.gz \
   && find /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/ -iname src.zip -delete \
   && find /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/ -iname *.src.zip -delete

# TODO Find more ways to strip it down, alternatively build from source with optimisation for size
   
COPY graalvm-ce-java11 /tmp/

RUN install_clean \
      equivs \
      gcc \
      zlib1g-dev \
   && equivs-build /tmp/graalvm-ce-java11 \
   && dpkg -i /graalvm-ce-java11_${GRAALVM_VERSION}_all.deb \
   && apt-get autoremove -q -y equivs \
   && rm /graalvm-ce-java11_${GRAALVM_VERSION}_all.deb \
   && rm /tmp/graalvm-ce-java11

# Only the most commonly used executables are added to the alternatives system
# no manpage files in java11 build + slightly different binary paths than for java8
COPY initCustomJavaCACertificates.sh /etc/my_init.d/00_initCustomJavaCACertificates.sh
RUN update-alternatives --install /usr/bin/java java /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/java 100 \
   && update-alternatives --install /usr/bin/jjs jjs /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/jjs 100 \
   && update-alternatives --install /usr/bin/polyglot polyglot /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/polyglot 100 \
   && update-alternatives --install /usr/bin/keytool keytool /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/keytool 100 \
   && update-alternatives --install /usr/bin/rmid rmid /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/rmid 100 \
   && update-alternatives --install /usr/bin/rmiregistry rmiregistry /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/rmiregistry 100 \
   && update-alternatives --install /usr/bin/javac javac /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/javac 100 \
   && update-alternatives --install /usr/bin/javap javap /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/javap 100 \
   && update-alternatives --install /usr/bin/jstack jstack /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/jstack 100 \
   && update-alternatives --install /usr/bin/jmap jmap /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/jmap 100 \
   && update-alternatives --install /usr/bin/jar jar /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/jar 100 \
   && update-alternatives --install /usr/bin/javadoc javadoc /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/bin/javadoc 100 \
   && mkdir -p /etc/ssl/certs/java \
   && mv /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/lib/security/cacerts /etc/ssl/certs/java/ \
   && ln -s /etc/ssl/certs/java/cacerts /usr/lib/jvm/graalvm-ce-java11-${GRAALVM_VERSION}/lib/security/cacerts \
   && chmod +x /etc/my_init.d/00_initCustomJavaCACertificates.sh

LABEL vendor="${docker.labels.vendor}" \
   ${docker.labels.namespace}.version="${project.version.majorVersion}.${project.version.minorVersion}.${project.version.incrementalVersion}" \
   ${docker.labels.namespace}.is-beta="" \
   ${docker.labels.namespace}.is-production="" \
   ${docker.labels.namespace}.release-date="${docker.labels.release-date}" \
   ${docker.labels.namespace}.maintainer="${docker.labels.maintainer}"